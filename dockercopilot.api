syntax = "v1"

// 本文件与 internal/handler/routes.go 保持同步；修改路由时请同时更新此处，
// 否则重新执行 goctl 会覆盖 internal/types/types.go 里手写补充的字段。

type (
	DoLoginReq {
		SecretKey string `form:"secret_key,optional"`
	}

	LoginReq {
		SecretKey   string `form:"secretKey,optional" json:"secretKey,optional"`
		CaptchaId   string `form:"captchaId,optional" json:"captchaId,optional"`
		CaptchaCode string `form:"captchaCode,optional" json:"captchaCode,optional"`
	}

	VerifyJwtReq {
		Jwt string `form:"jwt,optional"`
	}

	GetProgressReq {
		TaskId string `path:"taskid"`
	}

	IdReq {
		Id string `path:"id"`
	}

	ContainerRenameReq {
		IdReq
		NewName string `form:"newName"`
	}

	ContainerRestoreReq {
		Filename string `json:"filename"`
	}

	DelContainerBackupReq {
		Filename string `form:"filename"`
	}

	ContainerUpdateReq {
		IdReq
		ImageNameAndTag string `form:"imageNameAndTag"`
		ContainerName   string `form:"containerName"`
	}

	RemoveImageReq {
		IdReq
		Force bool `form:"force,default=false"`
	}

	ImagePullReq {
		Image string `json:"image"`
	}

	ImagePruneReq {
		Keep     int  `json:"keep"`
		Dangling bool `json:"dangling"`
		DryRun   bool `json:"dryRun"`
	}

	SystemPruneReq {
		BuildCache     bool `json:"buildCache"`
		DanglingImages bool `json:"danglingImages"`
	}

	VersionReq {
		Type string `form:"type"`
	}

	SettingsUpdateReq {
		IgnoreImages      string `json:"ignoreImages"`
		IgnoreContainers  string `json:"ignoreContainers"`
		NotifyURL         string `json:"notifyUrl"`
		NotifyFormat      string `json:"notifyFormat"`
		AutoUpdate        string `json:"autoUpdate"`
		AutoUpdateCron    string `json:"autoUpdateCron"`
		AutoUpdateInclude string `json:"autoUpdateInclude"`
		AutoUpdateMax     string `json:"autoUpdateMax"`
		PruneOldImages    string `json:"pruneOldImages"`
		PruneKeep         string `json:"pruneKeep"`
		PruneDangling     string `json:"pruneDangling"`
		PruneDryRun       string `json:"pruneDryRun"`
		WecomCorpID       string `json:"wecomCorpId"`
		WecomSecret       string `json:"wecomSecret"`
		WecomAgentID      string `json:"wecomAgentId"`
		WecomToUser       string `json:"wecomToUser"`
		WecomProxy        string `json:"wecomProxy"`
	}

	MsgResp {
		Status string `json:"status"`
		Msg    string `json:"msg"`
	}

	Resp {
		Code int         `json:"code"`
		Msg  string      `json:"msg"`
		Data interface{} `json:"data"`
	}

	VersionMsgResp {
		Version   string `json:"version"`
		BuildDate string `json:"build_date"`
	}
)

service dockerCopilot {
	@handler webindex
		get /
}

@server(
	prefix: /api
	group: auth
)
service dockerCopilot {
	@handler Login
		post /auth (LoginReq) returns (Resp)

	@handler Captcha
		get /auth/captcha returns (Resp)
}

@server(
	prefix: /api
	jwt: Auth
)
service dockerCopilot {
	@handler Logout
		post /auth/logout returns (Resp)

	@handler containersList
		get /containers returns (Resp)

	@handler rename
		post /container/:id/rename (ContainerRenameReq) returns (Resp)

	@handler restart
		post /container/:id/restart (IdReq) returns (Resp)

	@handler start
		post /container/:id/start (IdReq) returns (Resp)

	@handler stop
		post /container/:id/stop (IdReq) returns (Resp)

	@handler update
		post /container/:id/update (ContainerUpdateReq) returns (Resp)

	@handler backup
		get /container/backup returns (Resp)

	@handler backup2compose
		get /container/backup2compose returns (Resp)

	@handler delRestore
		delete /container/backups (DelContainerBackupReq) returns (Resp)

	@handler restore
		post /container/backups/restore (ContainerRestoreReq) returns (Resp)

	@handler listBackups
		get /container/listBackups returns (Resp)

	@handler pull
		post /image/pull (ImagePullReq) returns (Resp)

	@handler detail
		get /image/detail/:id (IdReq) returns (Resp)

	@handler prune
		post /image/prune (ImagePruneReq) returns (Resp)

	@handler DF
		get /system/df returns (Resp)

	@handler Prune
		post /system/prune (SystemPruneReq) returns (Resp)

	@handler GetSettings
		get /settings returns (Resp)

	@handler UpdateSettings
		post /settings (SettingsUpdateReq) returns (Resp)

	@handler TestNotify
		post /settings/test-notify (SettingsUpdateReq) returns (Resp)

	@handler imagesList
		get /images returns (Resp)

	@handler remove
		delete /image/:id (RemoveImageReq) returns (Resp)

	@handler GetProgress
		get /progress/:taskid (GetProgressReq) returns (Resp)

	@handler updateProgram
		put /program returns (Resp)

	@handler version
		get /version (VersionReq) returns (Resp)
}

@server(
	prefix: /api/icons
	jwt: Auth
)
service dockerCopilot {
	@handler upload
		post / returns (Resp)

	@handler obtain
		get / returns (Resp)
}
